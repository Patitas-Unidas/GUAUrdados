rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function servicioHabilitado() {
      return firestore.get(/databases/(default)/documents/configuracion/servicio)
        .data.habilitada == true;
    }

    match /{folder}/{filename} {
      allow read: if request.auth != null && servicioHabilitado() && folder in ['images', 'carnets'];
      allow create, update: if request.auth != null && servicioHabilitado()
        && request.auth.token.admin == true
        && folder in ['images', 'carnets']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && servicioHabilitado()
        && request.auth.token.admin == true
        && folder in ['images', 'carnets'];
    }
  }
}
