rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite las consultas collectionGroup('publicaciones') de los foros.
    match /{path=**}/publicaciones/{publicacionId} {
      allow read: if request.auth != null;
    }

    match /perros/{perroId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.token.admin == true;
      allow update: if request.auth != null && (
        request.auth.token.admin == true ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['seguidores']) &&
          request.resource.data.seguidores.toSet()
            .difference(resource.data.seguidores.toSet())
            .hasOnly([request.auth.uid]) &&
          resource.data.seguidores.toSet()
            .difference(request.resource.data.seguidores.toSet())
            .hasOnly([request.auth.uid])
        ) || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ultimaAguaEn', 'actualizadoEn']) &&
          request.resource.data.ultimaAguaEn == request.time &&
          request.resource.data.actualizadoEn == request.time
        ) || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ultimaComida', 'ultimaComidaEn', 'actualizadoEn']) &&
          request.resource.data.keys()
            .hasAll(['ultimaComida', 'ultimaComidaEn', 'actualizadoEn']) &&
          request.resource.data.ultimaComida is string &&
          request.resource.data.ultimaComida.size() > 0 &&
          request.resource.data.ultimaComida.size() <= 120 &&
          request.resource.data.ultimaComidaEn == request.time &&
          request.resource.data.actualizadoEn == request.time
        )
      );
    }

    // Perfil público mínimo para mostrar nombre y foto de los seguidores.
    // Los tokens FCM se mantienen aislados en la colección privada `usuarios`.
    match /perfiles_publicos/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'usuario', 'fotoUrl', 'actualizadoEn'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.usuario is string
        && request.resource.data.usuario.size() <= 100
        && request.resource.data.fotoUrl is string
        && request.resource.data.fotoUrl.size() <= 2048
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /emergencias/{emergenciaId} {
      function datosComunes() {
        let datos = request.resource.data;
        return datos.creadoPor == request.auth.uid
          && datos.tipo is string
          && datos.tipo.size() > 0
          && datos.tipo.size() <= 60
          && datos.ubicacion is string
          && datos.ubicacion.size() <= 200
          && datos.creadoEn == request.time;
      }

      function formatoAnterior() {
        let datos = request.resource.data;
        return datos.keys().hasOnly(['idPerro', 'nombrePerro', 'tipo', 'ubicacion', 'creadoPor', 'creadoEn'])
          && (datos.idPerro == null || datos.idPerro is string)
          && (datos.nombrePerro == null || datos.nombrePerro is string);
      }

      function variosPerros() {
        let datos = request.resource.data;
        return datos.keys().hasOnly(['idsPerros', 'nombresPerros', 'tipo', 'ubicacion', 'creadoPor', 'nombreUsuario', 'estado', 'creadoEn'])
          && datos.keys().hasAll(['idsPerros', 'nombresPerros', 'nombreUsuario', 'estado'])
          && datos.idsPerros is list
          && datos.idsPerros.size() <= 15
          && datos.nombresPerros is list
          && datos.nombresPerros.size() == datos.idsPerros.size()
          && datos.nombreUsuario is string
          && datos.nombreUsuario.size() <= 100
          && datos.estado == 'en_curso';
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
        && datosComunes()
        && (formatoAnterior() || variosPerros());
      allow update: if request.auth != null
        && (resource.data.creadoPor == request.auth.uid || request.auth.token.admin == true)
        && resource.data.get('estado', 'en_curso') == 'en_curso'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'nota', 'cerradaEn'])
        && request.resource.data.estado in ['resuelta', 'veterinario', 'falsa_alarma']
        && request.resource.data.cerradaEn == request.time
        && request.resource.data.get('nota', '') is string
        && request.resource.data.get('nota', '').size() <= 200;
    }

    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /foro/{foroId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['idperro'])
        && request.resource.data.idperro is string
        && request.resource.data.idperro.size() > 0
        && foroId == request.resource.data.idperro
        && exists(/databases/$(database)/documents/perros/$(request.resource.data.idperro));
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['idperro'])
        && request.resource.data.idperro == resource.data.idperro
        && resource.data.idperro is string
        && exists(/databases/$(database)/documents/perros/$(resource.data.idperro));
      allow delete: if request.auth != null && request.auth.token.admin == true;

      match /publicaciones/{publicacionId} {
        function esPublicacionValida() {
          let datos = request.resource.data;
          let camposComunes = [
            'idPerro', 'nombrePerro', 'idUsuario', 'nombreUsuario',
            'tipoPublicacion', 'descripcion', 'creadoEn'
          ];
          let camposOpcionales = ['fotoUsuario', 'tipoComida', 'cantidadComida', 'procedimiento'];
          return datos.keys().hasAll(camposComunes)
            && datos.keys().hasOnly(camposComunes.concat(camposOpcionales))
            && datos.idPerro is string
            && datos.idPerro == get(/databases/$(database)/documents/foro/$(foroId)).data.idperro
            && datos.nombrePerro is string
            && datos.nombrePerro.size() > 0
            && datos.nombreUsuario is string
            && datos.nombreUsuario.size() > 0
            && datos.nombreUsuario.size() <= 100
            && datos.idUsuario == request.auth.uid
            && datos.tipoPublicacion in ['normal', 'alimentacion', 'estado_medico']
            && datos.descripcion is string
            && datos.creadoEn == request.time
            && (!('fotoUsuario' in datos) || datos.fotoUsuario is string)
            && (
              (datos.tipoPublicacion == 'normal'
                && datos.descripcion.size() > 0
                && datos.descripcion.size() <= 2000
                && !('tipoComida' in datos)
                && !('cantidadComida' in datos)
                && !('procedimiento' in datos))
              ||
              (datos.tipoPublicacion == 'alimentacion'
                && datos.descripcion.size() <= 500
                && 'tipoComida' in datos
                && datos.tipoComida is string
                && datos.tipoComida.size() > 0
                && datos.tipoComida.size() <= 60
                && 'cantidadComida' in datos
                && datos.cantidadComida is string
                && datos.cantidadComida.size() > 0
                && datos.cantidadComida.size() <= 80
                && !('procedimiento' in datos))
              ||
              (datos.tipoPublicacion == 'estado_medico'
                && datos.descripcion.size() <= 500
                && 'procedimiento' in datos
                && datos.procedimiento is string
                && datos.procedimiento.size() > 0
                && datos.procedimiento.size() <= 500
                && !('tipoComida' in datos)
                && !('cantidadComida' in datos))
            );
        }

        function esPerritoNuevo() {
          let datos = request.resource.data;
          return datos.keys().hasAll(['idUsuario', 'nombreUsuario', 'tipoPublicacion', 'descripcion', 'creadoEn'])
            && datos.keys().hasOnly(['idUsuario', 'nombreUsuario', 'tipoPublicacion', 'descripcion', 'creadoEn', 'fotoUsuario', 'ubicacion'])
            && datos.idUsuario == request.auth.uid
            && datos.nombreUsuario is string
            && datos.nombreUsuario.size() > 0
            && datos.nombreUsuario.size() <= 100
            && datos.tipoPublicacion == 'perrito_nuevo'
            && datos.descripcion is string
            && datos.descripcion.size() > 0
            && datos.descripcion.size() <= 1000
            && datos.creadoEn == request.time
            && (!('fotoUsuario' in datos) || datos.fotoUsuario is string)
            && (!('ubicacion' in datos) || (datos.ubicacion is string && datos.ubicacion.size() <= 200));
        }

        allow read: if request.auth != null;
        allow create: if request.auth != null
          && (
            (foroId == 'sin_registrar' && esPerritoNuevo())
            || (exists(/databases/$(database)/documents/foro/$(foroId))
              && exists(/databases/$(database)/documents/perros/$(request.resource.data.idPerro))
              && esPublicacionValida())
          );
        function admiteReacciones() {
          return resource.data.tipoPublicacion in ['normal', 'perrito_nuevo'];
        }

        function cambia() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        function esReaccionPropia() {
          let antes = resource.data.get('reacciones', {});
          let despues = request.resource.data.get('reacciones', {});
          let mia = despues.get(request.auth.uid, null);
          return admiteReacciones()
            && cambia().hasOnly(['reacciones'])
            && despues is map
            && despues.diff(antes).affectedKeys().hasOnly([request.auth.uid])
            && (mia == null
              || (mia is map
                && mia.keys().hasAll(['e', 'n'])
                && mia.keys().hasOnly(['e', 'n', 'f'])
                && mia.e in ['❤️', '🥰', '🐶', '😂', '😮', '😢', '💪']
                && mia.n is string && mia.n.size() > 0 && mia.n.size() <= 100
                && (!('f' in mia) || mia.f is string)));
        }

        function sumaComentario() {
          let ultimo = request.resource.data.ultimoComentario;
          return admiteReacciones()
            && cambia().hasOnly(['numComentarios', 'ultimoComentario'])
            && request.resource.data.numComentarios == resource.data.get('numComentarios', 0) + 1
            && ultimo is map
            && ultimo.keys().hasOnly(['idUsuario', 'nombre', 'en'])
            && ultimo.idUsuario == request.auth.uid
            && ultimo.nombre is string && ultimo.nombre.size() <= 100
            && ultimo.en == request.time;
        }

        function restaComentario() {
          return cambia().hasOnly(['numComentarios'])
            && request.resource.data.numComentarios == resource.data.get('numComentarios', 0) - 1
            && request.resource.data.numComentarios >= 0;
        }

        allow update: if request.auth != null
          && (esReaccionPropia() || sumaComentario() || restaComentario());

        allow update: if request.auth != null
          && request.auth.token.admin == true
          && foroId == 'sin_registrar'
          && resource.data.tipoPublicacion == 'perrito_nuevo'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resultadoAviso', 'idPerroAviso', 'notaGuau', 'revisadoEn', 'revisadoPor'])
          && request.resource.data.resultadoAviso in ['registrado', 'ya_registrado']
          && (!('idPerroAviso' in request.resource.data) || exists(/databases/$(database)/documents/perros/$(request.resource.data.idPerroAviso)))
          && (!('notaGuau' in request.resource.data) || (request.resource.data.notaGuau is string && request.resource.data.notaGuau.size() <= 500))
          && (!('revisadoPor' in request.resource.data) || request.resource.data.revisadoPor == request.auth.uid);
        allow delete: if request.auth != null
          && (request.auth.token.admin == true || resource.data.idUsuario == request.auth.uid);

        match /comentarios/{comentarioId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null
            && get(/databases/$(database)/documents/foro/$(foroId)/publicaciones/$(publicacionId)).data.tipoPublicacion in ['normal', 'perrito_nuevo']
            && request.resource.data.keys().hasAll(['idUsuario', 'nombreUsuario', 'texto', 'creadoEn'])
            && request.resource.data.keys().hasOnly(['idUsuario', 'nombreUsuario', 'fotoUsuario', 'texto', 'creadoEn'])
            && request.resource.data.idUsuario == request.auth.uid
            && request.resource.data.nombreUsuario is string
            && request.resource.data.nombreUsuario.size() > 0
            && request.resource.data.nombreUsuario.size() <= 100
            && request.resource.data.texto is string
            && request.resource.data.texto.size() > 0
            && request.resource.data.texto.size() <= 500
            && request.resource.data.creadoEn == request.time
            && (!('fotoUsuario' in request.resource.data) || request.resource.data.fotoUsuario is string);
          allow update: if false;
          allow delete: if request.auth != null
            && (request.auth.token.admin == true || resource.data.idUsuario == request.auth.uid);
        }
      }
    }
  }
}
